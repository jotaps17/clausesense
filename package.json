{
  "name": "clausesentinel",
  "version": "0.1.0",
  "description": "Browser extension that flags legal hazards in terms and privacy policies",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:chrome": "node scripts/build.mjs chrome",
    "build:firefox": "node scripts/build.mjs firefox",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "typecheck": "tsc --noEmit",
    "serve:test": "npx --yes serve test/web -p 3131"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/firefox-webext-browser": "^120.0.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "esbuild": "^0.21.5",
    "jest": "^29.7.0",
    "preact": "^10.22.0",
    "ts-jest": "^29.1.5",
    "typescript": "^5.5.2",
    "webextension-polyfill": "^0.10.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/engine/__tests__/**/*.test.ts",
      "**/test/**/*.spec.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  }
}
