{
  "manifest_version": 3,
  "name": "ClauseSentinel",
  "version": "0.1.0",
  "description": "Scans terms, privacy policies and agreements for data, privacy, and security hazards. Not legal advice.",
  "action": {
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "service_worker": "background/index.js"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [],
  "web_accessible_resources": [],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  }
}
